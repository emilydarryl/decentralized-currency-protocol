set -euo pipefail

script_path="${BASH_SOURCE[0]}"
[[ "${script_path}" == */* ]] || script_path="./${script_path}"
SCRIPT_DIR="$(cd -- "${script_path%/*}" && pwd)"
BIN_DIR="${SOVEROOT_BIN_DIR:-${SCRIPT_DIR}/bin}"
DATA_DIR="${SOVEROOT_LABNET_HOME:-${HOME:?HOME must be set}/.soveroot-labnet-kit}"
SOVRD="${BIN_DIR}/sovrd"
SOVR_CLI="${BIN_DIR}/sovr-cli"
AUTONOMY_MINER="${SOVEROOT_AUTONOMY_MINER:-${SCRIPT_DIR}/libexec/autonomous_labnet_miner.py}"
ACCOUNTING_COORDINATOR="${SOVEROOT_ACCOUNTING_COORDINATOR:-${SCRIPT_DIR}/libexec/share_accounting_coordinator.py}"
SV2_REFERENCE="${SOVEROOT_SV2_REFERENCE:-${SCRIPT_DIR}/libexec/soveroot-sv2-reference}"
ACCOUNTING_PORT="${SOVEROOT_ACCOUNTING_PORT:-29445}"
SV2_PORT="${SOVEROOT_SV2_PORT:-29446}"
CONFIG_FILE="${DATA_DIR}/soveroot-labnet.conf"
COMMON_ARGS=(-chain=labnet "-datadir=${DATA_DIR}" "-conf=${CONFIG_FILE}")

usage() {
    cat <<'EOF'
Soveroot Labnet Kit - local test-only node, wallet, and mining helper

Usage: ./soveroot-labnet <command> [arguments]

Commands:
  start               Start a loopback-only labnet node.
  status              Show chain status and loaded wallets.
  demo                Create miner/receiver wallets, mine test coins,
                      send one coin, and mine its confirmation.
  autonomy-demo       Build, solve, and directly submit one block outside
                      the daemon, without a pool coordinator.
  coordinator-failure-demo
                      Report work to optional accounting, stop the
                      coordinator, then prove direct mining continues.
  job-declaration-demo
                      Declare a miner-built job over authenticated Stratum V2,
                      stop the coordinator, and prove direct fallback.
  mine [blocks]       Mine blocks to the miner wallet (default: 1).
  cli <args...>       Run an arbitrary sovr-cli command on this labnet.
  stop                Stop the local labnet node cleanly.
  help                Show this help.

Environment:
  SOVEROOT_BIN_DIR      Directory containing sovrd and sovr-cli.
  SOVEROOT_LABNET_HOME Data directory (default: ~/.soveroot-labnet-kit).

Labnet coins have no monetary value. This kit is not production software.
EOF
}

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

require_binaries() {
    [[ -x "${SOVRD}" ]] || die "${SOVRD} is missing or not executable"
    [[ -x "${SOVR_CLI}" ]] || die "${SOVR_CLI} is missing or not executable"
}

require_autonomy_miner() {
    command -v python3 >/dev/null 2>&1 || die "python3 is required for autonomy-demo"
    [[ -r "${AUTONOMY_MINER}" ]] || die "${AUTONOMY_MINER} is missing or unreadable"
}

require_accounting_coordinator() {
    require_autonomy_miner
    [[ -r "${ACCOUNTING_COORDINATOR}" ]] || die "${ACCOUNTING_COORDINATOR} is missing or unreadable"
    [[ "${ACCOUNTING_PORT}" =~ ^[0-9]+$ ]] || die "SOVEROOT_ACCOUNTING_PORT must be a whole number"
    ((ACCOUNTING_PORT >= 1024 && ACCOUNTING_PORT <= 65535)) || die "SOVEROOT_ACCOUNTING_PORT must be between 1024 and 65535"
}

require_sv2_reference() {
    require_autonomy_miner
    [[ -x "${SV2_REFERENCE}" ]] || die "${SV2_REFERENCE} is missing or not executable"
    [[ "${SV2_PORT}" =~ ^[0-9]+$ ]] || die "SOVEROOT_SV2_PORT must be a whole number"
    ((SV2_PORT >= 1024 && SV2_PORT <= 65535)) || die "SOVEROOT_SV2_PORT must be between 1024 and 65535"
}

write_config() {
    umask 077
    mkdir -p -- "${DATA_DIR}"
    cat >"${CONFIG_FILE}" <<'EOF'
chain=labnet
server=1
listen=1
discover=0
dnsseed=0
natpmp=0
listenonion=0

[labnet]
bind=127.0.0.1:29444
rpcbind=127.0.0.1
fallbackfee=0.0002
EOF
}

cli_call() {
    "${SOVR_CLI}" "${COMMON_ARGS[@]}" "$@"
}

wallet_call() {
    local wallet="$1"
    shift
    "${SOVR_CLI}" "${COMMON_ARGS[@]}" "-rpcwallet=${wallet}" "$@"
}

node_is_running() {
    cli_call getblockchaininfo >/dev/null 2>&1
}

require_running() {
    node_is_running || die "the local labnet node is not running; use './soveroot-labnet start' first"
}

ensure_wallet() {
    local wallet="$1"
    if wallet_call "${wallet}" getwalletinfo >/dev/null 2>&1; then
        return
    fi
    if cli_call loadwallet "${wallet}" >/dev/null 2>&1; then
        return
    fi
    cli_call createwallet "${wallet}" >/dev/null
}

mine_blocks() {
    local count="$1"
    [[ "${count}" =~ ^[1-9][0-9]*$ ]] || die "block count must be a positive whole number"
    require_binaries
    require_running
    ensure_wallet miner
    local address height
    address="$(wallet_call miner getnewaddress)"
    cli_call generatetoaddress "${count}" "${address}" >/dev/null
    height="$(cli_call getblockcount)"
    printf 'Mined %s labnet block(s) to %s\n' "${count}" "${address}"
    printf 'Current height: %s\n' "${height}"
}

command_start() {
    require_binaries
    write_config
    if node_is_running; then
        printf 'Soveroot labnet is already running.\n'
        return
    fi
    "${SOVRD}" "${COMMON_ARGS[@]}" -server=1 -daemonwait
    cli_call -rpcwait -rpcwaittimeout=60 getblockchaininfo >/dev/null
    printf 'Soveroot labnet started.\n'
    printf 'Data directory: %s\n' "${DATA_DIR}"
    printf 'RPC: loopback only (127.0.0.1:29443)\n'
    printf 'P2P: loopback only (127.0.0.1:29444)\n'
}

command_status() {
    require_binaries
    require_running
    printf '%s\n' 'Chain status:'
    cli_call getblockchaininfo
    printf '\n%s\n' 'Loaded wallets:'
    cli_call listwallets
}

command_demo() {
    require_binaries
    require_running
    ensure_wallet miner
    ensure_wallet receiver

    printf '%s\n' 'Mining 101 fresh blocks so the miner wallet has spendable test coins...'
    mine_blocks 101

    local receiving_address txid mining_address balance
    receiving_address="$(wallet_call receiver getnewaddress)"
    txid="$(wallet_call miner sendtoaddress "${receiving_address}" 1)"
    mining_address="$(wallet_call miner getnewaddress)"
    cli_call generatetoaddress 1 "${mining_address}" >/dev/null
    balance="$(wallet_call receiver getbalance)"

    printf 'Sent 1 test-only coin to %s\n' "${receiving_address}"
    printf 'Transaction: %s\n' "${txid}"
    printf 'Receiver balance: %s\n' "${balance}"
    printf '%s\n' 'Demo complete. Labnet coins have no monetary value.'
}

command_autonomy_demo() {
    require_binaries
    require_autonomy_miner
    require_running
    ensure_wallet miner

    local address before_height after_height
    address="$(wallet_call miner getnewaddress)"
    before_height="$(cli_call getblockcount)"
    python3 "${AUTONOMY_MINER}" \
        --cli "${SOVR_CLI}" \
        --datadir "${DATA_DIR}" \
        --conf "${CONFIG_FILE}" \
        --wallet miner \
        --address "${address}"
    after_height="$(cli_call getblockcount)"
    [[ "${after_height}" -eq "$((before_height + 1))" ]] || die "autonomous block did not advance the chain by one"
    printf '%s\n' 'No pool coordinator was used: the external miner built and published this block directly.'
    printf '%s\n' 'Labnet uses inherited easy development proof of work; this is not the final Soveroot PoW.'
}

command_coordinator_failure_demo() (
    set -euo pipefail
    require_binaries
    require_accounting_coordinator
    require_running
    ensure_wallet miner

    local run_dir ledger ready_file coordinator_log coordinator_pid endpoint miner_log miner_pid
    local before_height after_height current_height address online_receipts final_receipts accepted_blocks
    run_dir="$(mktemp -d "${DATA_DIR}/accounting-failure-demo.XXXXXX")"
    ledger="${run_dir}/work-receipts.jsonl"
    ready_file="${run_dir}/ready"
    coordinator_log="${run_dir}/coordinator.log"
    coordinator_pid=""
    miner_pid=""
    endpoint="http://127.0.0.1:${ACCOUNTING_PORT}/share"

    cleanup_coordinator() {
        if [[ -n "${miner_pid}" ]] && kill -0 "${miner_pid}" >/dev/null 2>&1; then
            kill "${miner_pid}" >/dev/null 2>&1 || true
            wait "${miner_pid}" >/dev/null 2>&1 || true
        fi
        if [[ -n "${coordinator_pid}" ]] && kill -0 "${coordinator_pid}" >/dev/null 2>&1; then
            kill "${coordinator_pid}" >/dev/null 2>&1 || true
            wait "${coordinator_pid}" >/dev/null 2>&1 || true
        fi
    }
    trap cleanup_coordinator EXIT

    python3 "${ACCOUNTING_COORDINATOR}" \
        --bind 127.0.0.1 \
        --port "${ACCOUNTING_PORT}" \
        --ledger "${ledger}" \
        --ready-file "${ready_file}" >"${coordinator_log}" 2>&1 &
    coordinator_pid="$!"
    for _ in $(seq 1 100); do
        [[ -f "${ready_file}" ]] && break
        kill -0 "${coordinator_pid}" >/dev/null 2>&1 || {
            sed -n '1,20p' "${coordinator_log}" >&2
            die "accounting coordinator stopped before becoming ready"
        }
        sleep 0.05
    done
    [[ -f "${ready_file}" ]] || die "accounting coordinator did not become ready"

    before_height="$(cli_call getblockcount)"
    address="$(wallet_call miner getnewaddress)"
    miner_log="${run_dir}/miner.log"
    python3 "${AUTONOMY_MINER}" \
        --cli "${SOVR_CLI}" \
        --datadir "${DATA_DIR}" \
        --conf "${CONFIG_FILE}" \
        --wallet miner \
        --address "${address}" \
        --share-endpoint "${endpoint}" \
        --worker coordinator-proof \
        --blocks 2 \
        --inter-block-delay 2 >"${miner_log}" 2>&1 &
    miner_pid="$!"
    for _ in $(seq 1 200); do
        current_height="$(cli_call getblockcount)"
        if [[ -s "${ledger}" ]] && [[ "${current_height}" -ge "$((before_height + 1))" ]]; then
            break
        fi
        kill -0 "${miner_pid}" >/dev/null 2>&1 || {
            sed -n '1,40p' "${miner_log}" >&2
            die "miner stopped before its first coordinated block"
        }
        sleep 0.05
    done
    current_height="$(cli_call getblockcount)"
    [[ -s "${ledger}" ]] || die "coordinator did not record the miner's first block work"
    [[ "${current_height}" -ge "$((before_height + 1))" ]] || die "miner did not publish its first block"
    read -r online_receipts < <(wc -l <"${ledger}")
    ((online_receipts >= 1)) || die "coordinator receipt ledger is empty"

    kill "${coordinator_pid}"
    wait "${coordinator_pid}" >/dev/null 2>&1 || true
    coordinator_pid=""
    printf '%s\n' 'Accounting coordinator stopped before the second block.'
    wait "${miner_pid}" || {
        sed -n '1,80p' "${miner_log}" >&2
        die "the continuing miner process failed after coordinator shutdown"
    }
    miner_pid=""
    sed -n '1,80p' "${miner_log}"
    grep -Eq 'Share reports failed without stopping mining: [1-9][0-9]*' "${miner_log}" || die "offline report failure was not observed"
    accepted_blocks="$(grep -c '^Autonomous external block accepted:' "${miner_log}")"
    [[ "${accepted_blocks}" -eq 2 ]] || die "the same miner process did not publish two blocks"

    after_height="$(cli_call getblockcount)"
    [[ "${after_height}" -eq "$((before_height + 2))" ]] || die "two external blocks did not advance the chain by two"
    read -r final_receipts < <(wc -l <"${ledger}")
    [[ "${final_receipts}" -eq "${online_receipts}" ]] || die "ledger changed after the coordinator stopped"
    printf 'Coordinator accepted %s verified work receipt(s) before shutdown.\n' "${online_receipts}"
    printf 'Mining continued after coordinator shutdown: chain advanced to height %s.\n' "${after_height}"
    printf '%s\n' 'The coordinator supplied no template and published no block.'
    printf 'Evidence retained in: %s\n' "${run_dir}"
)

command_job_declaration_demo() (
    set -euo pipefail
    require_binaries
    require_sv2_reference
    require_running
    ensure_wallet miner

    local run_dir authority_file ready_file coordinator_log coordinator_pid endpoint public_key
    local miner_log miner_pid before_height current_height after_height address accepted_blocks
    run_dir="$(mktemp -d "${DATA_DIR}/job-declaration-demo.XXXXXX")"
    authority_file="${run_dir}/authority.json"
    ready_file="${run_dir}/ready.json"
    coordinator_log="${run_dir}/coordinator.log"
    coordinator_pid=""
    miner_pid=""
    endpoint="127.0.0.1:${SV2_PORT}"

    cleanup_job_declaration() {
        if [[ -n "${miner_pid}" ]] && kill -0 "${miner_pid}" >/dev/null 2>&1; then
            kill "${miner_pid}" >/dev/null 2>&1 || true
            wait "${miner_pid}" >/dev/null 2>&1 || true
        fi
        if [[ -n "${coordinator_pid}" ]] && kill -0 "${coordinator_pid}" >/dev/null 2>&1; then
            kill "${coordinator_pid}" >/dev/null 2>&1 || true
            wait "${coordinator_pid}" >/dev/null 2>&1 || true
        fi
    }
    trap cleanup_job_declaration EXIT

    umask 077
    public_key="$("${SV2_REFERENCE}" generate-authority --output "${authority_file}")"
    [[ -n "${public_key}" ]] || die "Stratum V2 helper did not return an authority public key"
    "${SV2_REFERENCE}" serve \
        --endpoint "${endpoint}" \
        --authority-file "${authority_file}" \
        --mode accept \
        --ready-file "${ready_file}" >"${coordinator_log}" 2>&1 &
    coordinator_pid="$!"
    for _ in $(seq 1 100); do
        [[ -f "${ready_file}" ]] && break
        kill -0 "${coordinator_pid}" >/dev/null 2>&1 || {
            sed -n '1,40p' "${coordinator_log}" >&2
            die "Stratum V2 coordinator stopped before becoming ready"
        }
        sleep 0.05
    done
    [[ -f "${ready_file}" ]] || die "Stratum V2 coordinator did not become ready"

    before_height="$(cli_call getblockcount)"
    address="$(wallet_call miner getnewaddress)"
    miner_log="${run_dir}/miner.log"
    python3 "${AUTONOMY_MINER}" \
        --cli "${SOVR_CLI}" \
        --datadir "${DATA_DIR}" \
        --conf "${CONFIG_FILE}" \
        --wallet miner \
        --address "${address}" \
        --sv2-helper "${SV2_REFERENCE}" \
        --sv2-endpoint "${endpoint}" \
        --sv2-authority-public-key "${public_key}" \
        --sv2-timeout-ms 500 \
        --blocks 2 \
        --inter-block-delay 2 >"${miner_log}" 2>&1 &
    miner_pid="$!"

    for _ in $(seq 1 200); do
        current_height="$(cli_call getblockcount)"
        if grep -Fq 'Job declaration status: accepted' "${miner_log}" 2>/dev/null && [[ "${current_height}" -ge "$((before_height + 1))" ]]; then
            break
        fi
        kill -0 "${miner_pid}" >/dev/null 2>&1 || {
            sed -n '1,100p' "${miner_log}" >&2
            die "miner stopped before its authenticated declaration block"
        }
        sleep 0.05
    done
    grep -Fq 'Job declaration status: accepted' "${miner_log}" || die "first job was not accepted over Stratum V2"
    kill "${coordinator_pid}"
    wait "${coordinator_pid}" >/dev/null 2>&1 || true
    coordinator_pid=""
    printf '%s\n' 'Authenticated Stratum V2 coordinator stopped before the second block.'

    wait "${miner_pid}" || {
        sed -n '1,140p' "${miner_log}" >&2
        die "the continuing miner process failed after Stratum V2 coordinator shutdown"
    }
    miner_pid=""
    sed -n '1,140p' "${miner_log}"
    [[ "$(grep -c '^Job declaration status: accepted' "${miner_log}")" -eq 1 ]] || die "expected exactly one accepted declaration"
    [[ "$(grep -c '^Job declaration status: direct_fallback' "${miner_log}")" -eq 1 ]] || die "expected exactly one direct fallback"
    accepted_blocks="$(grep -c '^Autonomous external block accepted:' "${miner_log}")"
    [[ "${accepted_blocks}" -eq 2 ]] || die "the same miner process did not directly publish two blocks"
    after_height="$(cli_call getblockcount)"
    [[ "${after_height}" -eq "$((before_height + 2))" ]] || die "job-declaration demo did not advance the chain by two"
    printf 'Same miner continued in direct fallback to height %s.\n' "${after_height}"
    printf '%s\n' 'The coordinator authenticated and accepted the first miner-created job but published neither block.'
    printf 'Evidence retained in: %s\n' "${run_dir}"
)

command_stop() {
    require_binaries
    if ! node_is_running; then
        printf 'Soveroot labnet is already stopped.\n'
        return
    fi
    cli_call stop >/dev/null
    for _ in $(seq 1 60); do
        if ! node_is_running; then
            printf 'Soveroot labnet stopped.\n'
            return
        fi
        sleep 1
    done
    die "the node did not stop within 60 seconds"
}

command="${1:-help}"
case "${command}" in
    start)
        [[ "$#" -eq 1 ]] || die "start takes no arguments"
        command_start
        ;;
    status)
        [[ "$#" -eq 1 ]] || die "status takes no arguments"
        command_status
        ;;
    demo)
        [[ "$#" -eq 1 ]] || die "demo takes no arguments"
        command_demo
        ;;
    autonomy-demo)
        [[ "$#" -eq 1 ]] || die "autonomy-demo takes no arguments"
        command_autonomy_demo
        ;;
    coordinator-failure-demo)
        [[ "$#" -eq 1 ]] || die "coordinator-failure-demo takes no arguments"
        command_coordinator_failure_demo
        ;;
    job-declaration-demo)
        [[ "$#" -eq 1 ]] || die "job-declaration-demo takes no arguments"
        command_job_declaration_demo
        ;;
    mine)
        [[ "$#" -le 2 ]] || die "mine accepts at most one block count"
        mine_blocks "${2:-1}"
        ;;
    cli)
        shift
        [[ "$#" -gt 0 ]] || die "cli requires a sovr-cli command"
        require_binaries
        require_running
        cli_call "$@"
        ;;
    stop)
        [[ "$#" -eq 1 ]] || die "stop takes no arguments"
        command_stop
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        die "unknown command '${command}'"
        ;;
esac
